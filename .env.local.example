# LLM プロバイダの切替。"groq" にすると Groq Llama 4 Scout、未指定または "gemini" で Gemini を使う。
FASELU_PROVIDER=gemini

# Gemini API キー（Google AI Studio で発行）
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# モード別モデル。
# - 対話モードは応答回数が多くテンポ重視。軽量で速い Gemma 26b を推奨。
# - 最終分析モードはレポート品質重視。Gemini 3.1 Flash Lite を推奨。
# 両方未指定の場合は FASELU_GEMINI_MODEL (後方互換) または "gemini-3.1-flash-lite" を使う。
FASELU_DIALOGUE_MODEL=gemma-4-26b-a4b-it
FASELU_FINAL_MODEL=gemini-3.1-flash-lite

# 旧式の単一モデル指定 (後方互換のフォールバック)。FASELU_DIALOGUE_MODEL /
# FASELU_FINAL_MODEL を両方設定するなら不要。
# FASELU_GEMINI_MODEL=gemini-3.1-flash-lite

# Groq API キー（https://console.groq.com/keys で発行）
GROQ_API_KEY=
